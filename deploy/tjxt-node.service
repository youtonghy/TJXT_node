[Unit]
Description=TJXT_node Xray agent for TONG-ladder
Documentation=https://github.com/youtonghy/TJXT_node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tjxt-node
Group=tjxt-node
WorkingDirectory=/usr/local/tjxt-node
ExecStart=/usr/local/tjxt-node/tjxt-node server -c /etc/tjxt-node/config.json
Restart=always
RestartSec=5
LimitNOFILE=infinity
LimitNPROC=infinity
TasksMax=infinity
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/etc/tjxt-node -/var/log/tjxt-node
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
